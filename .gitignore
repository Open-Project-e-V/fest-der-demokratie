*.iml
*.ipr
*.iws
out/
.idea_modules/
atlassian-ide-plugin.xml
http-client.private.env.json

# Visual Studio Code
.vscode/
*.code-workspace
.history/

# Vim / Neovim
[._]*.s[a-v][a-z]
!*.svg
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
Session.vim
Sessionx.vim
.netrwhist
*~
tags
[._]*.un~

# Emacs
\#*\#
.\#*
*.elc

# Sublime Text
*.sublime-project
*.sublime-workspace

# Fleet / Zed / Cursor
.fleet/
.zed/
.cursor/

